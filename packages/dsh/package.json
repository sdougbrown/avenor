{
  "name": "@dougbots/dsh-avenor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Avenor delegation for DeepSeek Harness",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@dougbots/avenor-core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "@types/node": "^25.8.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3"
  }
}
