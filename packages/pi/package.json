{
  "name": "@dougbots/avenor-pi",
  "version": "0.6.0",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sdougbrown/avenor",
    "directory": "packages/pi"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "tsdown",
    "test": "bun test",
    "dev": "tsdown --watch"
  },
  "dependencies": {
    "@dougbots/avenor-core": "workspace:*"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/bun": "^1.3.12",
    "@types/node": "^25.8.0",
    "tsdown": "^0.22.0",
    "typebox": "^1.2.17",
    "typescript": "^6.0.3"
  }
}
