{
  "compilerOptions": {
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "esModuleInterop": true,
    "types": [
      "node",
      "bun"
    ],
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@dougbots/avenor-core": [
        "../core/src/index.ts"
      ],
      "@dougbots/avenor-core/*": [
        "../core/src/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}
