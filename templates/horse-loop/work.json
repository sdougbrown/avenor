{
  "schema_version": 1,
  "template_id": "horse-loop-work",
  "template_version": "1.0.0",
  "metadata": {
    "title": "Horse issue loop",
    "description": "One lean review unit: a landed issue is implemented by a horse agent in an isolated worktree, published as a pull request, and cycled through external review and correction until the reviewer's verdict is clean. The address-pr discipline (triage, fix, reply, re-request) lives in the correction prompt; the review loop re-parks on each new exact head, so the cycle repeats until the verdict is clean. Merge authorization remains a manual human gate bound to the exact reviewed head. Plan hardening and campaign coordination are out of scope; this template is one workflow for one issue.",
    "source": "https://github.com/sdougbrown/avenor"
  },
  "entry_nodes": ["intake"],
  "nodes": [
    {
      "id": "intake",
      "name": "Intake",
      "action": {
        "type": "manual",
        "instructions": "A human supplies the verbatim issue body and the exact base SHA. This is a manual node: claim it, start it, then complete it with the issue text, the base SHA, and the issue artifact as evidence. Do not infer the issue from its number, title, or branch history."
      },
      "outputs": [
        { "id": "issue", "name": "Issue", "type": "string", "required": true },
        { "id": "base_sha", "name": "Base SHA", "type": "string", "required": true }
      ],
      "completion": { "kind": "explicit" },
      "branches": { "ready": "implement" }
    },
    {
      "id": "implement",
      "name": "Implement",
      "dependencies": ["intake"],
      "action": { "type": "run", "prompt_file": "prompts/implement.md" },
      "assignment": { "role": "implementer", "roster_file": "roster.json", "roster_entry": "implementer", "thinking": "high" },
      "dispatch": {
        "mode": "auto",
        "controller_id": "horse-loop",
        "priority": 30,
        "concurrency_key": { "prefix": "worktree:", "from_instance_param": "worktree" }
      },
      "outputs": [
        { "id": "implementation", "name": "Implementation summary", "type": "file", "required": true }
      ],
      "completion": {
        "kind": "files",
        "artifacts": [{ "path": "implementation.md", "non_empty": true }]
      },
      "branches": { "ready": "publication" }
    },
    {
      "id": "publication",
      "name": "Publication",
      "dependencies": ["implement"],
      "action": { "type": "run", "prompt_file": "prompts/publication.md" },
      "assignment": { "role": "publisher", "roster_file": "roster.json", "roster_entry": "publisher", "thinking": "medium" },
      "dispatch": {
        "mode": "auto",
        "controller_id": "horse-loop",
        "priority": 60,
        "concurrency_key": { "prefix": "worktree:", "from_instance_param": "worktree" }
      },
      "outputs": [
        { "id": "repository", "name": "Repository", "type": "string", "required": true, "source": { "artifact": "pr-info.json", "pointer": "/repository" } },
        { "id": "pr_head", "name": "PR head SHA", "type": "string", "required": true, "source": { "git": "head" } },
        { "id": "pr_number", "name": "PR number", "type": "number", "required": true, "source": { "artifact": "pr-info.json", "pointer": "/pr_number" } }
      ],
      "completion": {
        "kind": "files",
        "artifacts": [{ "path": "pr-info.json", "non_empty": true }]
      },
      "branches": { "published": "review" }
    },
    {
      "id": "review",
      "name": "External review",
      "dependencies": ["publication"],
      "action": { "type": "external", "source": "github", "subject_type": "pull_request" },
      "dispatch": {
        "mode": "auto",
        "controller_id": "horse-loop",
        "priority": 60,
        "concurrency_key": { "prefix": "worktree:", "from_instance_param": "worktree" },
        "success_outcome": "clean"
      },
      "completion": { "kind": "explicit" },
      "gates": [
        {
          "id": "review-verdict",
          "name": "External review verdict",
          "type": "external",
          "required": true,
          "subject_type": "pull_request",
          "adapter_id": "github-pr-review",
          "inputs": {
            "repository": { "from_node_output": { "node_id": "publication", "output_id": "repository" } },
            "pull_number": { "from_node_output": { "node_id": "publication", "output_id": "pr_number" } },
            "head_sha": { "from_node_output": { "node_id": "publication", "output_id": "pr_head" } }
          },
          "subject_binding": {
            "type": "pull_request",
            "repository": { "from_node_output": { "node_id": "publication", "output_id": "repository" } },
            "pull_request": { "from_node_output": { "node_id": "publication", "output_id": "pr_number" } },
            "revision": { "from_node_output": { "node_id": "publication", "output_id": "pr_head" } }
          },
          "result_outcomes": {
            "changes_requested": "changes_requested",
            "action_required": "action_required",
            "failed": "changes_requested"
          },
          "allowed_outcomes": ["clean", "changes_requested", "action_required", "replan", "checkpoint"]
        }
      ],
      "waive_rules": [
        { "authorities": ["human"], "reason_required": true }
      ],
      "branches": {
        "clean": "merge-auth",
        "changes_requested": "correction",
        "action_required": "correction",
        "replan": "implement",
        "checkpoint": "advisor"
      }
    },
    {
      "id": "correction",
      "name": "Correction (address-pr)",
      "dependencies": ["review"],
      "action": { "type": "run", "prompt_file": "prompts/correction.md" },
      "assignment": { "role": "implementer", "roster_file": "roster.json", "roster_entry": "implementer", "thinking": "high" },
      "dispatch": {
        "mode": "auto",
        "controller_id": "horse-loop",
        "priority": 70,
        "concurrency_key": { "prefix": "worktree:", "from_instance_param": "worktree" }
      },
      "outputs": [
        { "id": "correction_summary", "name": "Correction summary", "type": "file", "required": true }
      ],
      "completion": {
        "kind": "files",
        "artifacts": [{ "path": "correction.md", "non_empty": true }]
      },
      "branches": { "fixed": "publication" }
    },
    {
      "id": "merge-auth",
      "name": "Human merge authorization",
      "dependencies": ["review"],
      "action": {
        "type": "manual",
        "instructions": "A human authorizes merging the exact PR head that was reviewed. Complete this node with the authorized head SHA, then satisfy the merge-authorization gate with the exact subject (repository, pull request, and head SHA). The gate cannot be satisfied by PR state alone."
      },
      "outputs": [
        { "id": "authorized_head", "name": "Authorized head SHA", "type": "string", "required": true }
      ],
      "completion": { "kind": "explicit" },
      "gates": [
        {
          "id": "merge-authorization",
          "name": "Merge authorization",
          "type": "human",
          "required": true,
          "subject_type": "pull_request",
          "subject_binding": {
            "type": "pull_request",
            "repository": { "from_node_output": { "node_id": "publication", "output_id": "repository" } },
            "pull_request": { "from_node_output": { "node_id": "publication", "output_id": "pr_number" } },
            "revision": { "from_node_output": { "node_id": "publication", "output_id": "pr_head" } }
          },
          "allowed_outcomes": ["authorized"]
        }
      ],
      "branches": { "authorized": "reconciliation" }
    },
    {
      "id": "advisor",
      "name": "Advisor checkpoint",
      "dependencies": ["review"],
      "action": {
        "type": "manual",
        "instructions": "A manual checkpoint gate reached when review reports a checkpoint. A human or advisor decides whether to proceed to correction or abandon the work unit. Complete this node with outcome `proceed` to route to correction, or outcome `abandoned` to terminate the workflow without merging."
      },
      "outputs": [
        { "id": "advisor_decision", "name": "Advisor decision", "type": "string" }
      ],
      "completion": { "kind": "explicit" },
      "skip_rule": { "authorities": ["human"], "reason_required": true },
      "outcomes": [{ "name": "abandoned", "terminal": true }],
      "branches": { "proceed": "correction" }
    },
    {
      "id": "reconciliation",
      "name": "Reconciliation",
      "dependencies": ["merge-auth"],
      "action": { "type": "run", "prompt_file": "prompts/reconciliation.md" },
      "assignment": { "role": "reconciler", "roster_file": "roster.json", "roster_entry": "reconciler", "thinking": "medium" },
      "dispatch": {
        "mode": "auto",
        "controller_id": "horse-loop",
        "priority": 50,
        "concurrency_key": { "prefix": "worktree:", "from_instance_param": "worktree" }
      },
      "outputs": [
        { "id": "reconciliation", "name": "Reconciliation", "type": "file", "required": true }
      ],
      "completion": {
        "kind": "files",
        "artifacts": [{ "path": "reconciliation.md", "non_empty": true }]
      },
      "outcomes": [{ "name": "merged", "terminal": true }]
    }
  ],
  "terminal_outcomes": ["merged", "abandoned"],
  "params": [
    { "id": "worktree", "type": "string", "required": true },
    { "id": "worktree_path", "type": "string", "required": true }
  ],
  "working_directory": { "from_instance_param": "worktree_path" },
  "default_lease_policy": { "ttl_seconds": 1800, "heartbeat_interval_seconds": 600 },
  "default_retry_policy": { "max_attempts": 2, "exhaustion": "block" },
  "composition_limits": { "max_depth": 4, "max_children": 32 }
}
