# Durable Avenor stable supervisor (systemd, Linux).
#
# Placeholders to edit:
#   - binary path: /usr/local/bin/avenor (edit if avenor lives elsewhere)
#   - socket path: %S/avenor/remote/stable.sock (%S is the state directory,
#     usually /var/lib; use a literal path like /var/lib/avenor/remote/stable.sock
#     if you prefer)
#   - capacity numbers: --max-runtimes 16, --max-tree-budget 64,
#     --idempotency-capacity 1024 (raise deliberately for a busy remote host)
#
# The socket's directory must exist before the service starts:
#   install -d -m 700 /var/lib/avenor/remote

[Unit]
Description=Avenor stable supervisor (durable)

[Service]
# Run as a dedicated non-root user. BOTH units must use the same user: the
# control socket is created 0600, so the MCP server can only dial it when the
# two processes share the UID.
# StateDirectory=avenor pre-creates %S/avenor with ownership matching User=,
# so the %S/avenor paths below resolve correctly.
User=avenor
StateDirectory=avenor
# The supervisor spawns agent runtimes that write to arbitrary repo directories
# and need outbound network, so it is not aggressively sandboxed.
# NoNewPrivileges is the only hardening applied here.
NoNewPrivileges=true
ExecStart=/usr/local/bin/avenor stable --control-socket %S/avenor/remote/stable.sock --max-runtimes 16 --max-tree-budget 64 --idempotency-capacity 1024
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
