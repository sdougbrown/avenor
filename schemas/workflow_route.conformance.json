{
  "version": 1,
  "description": "Language-neutral conformance fixture for the avenor_workflow contract. 'repairs' is the template table every Repair()-rendered tool error is built from; 'applicability' is the per-action input contract the router validates against (permitted keys, required keys, and each key's declared type); 'cases' drives the router and the Go JSON-Schema test. A case's 'schema': true marks an input the JSON Schema must also reject. Facts are pre-quoted: a template carries no literal quotes and every fact that should render quoted arrives quoted.",
  "repairs": {
    "invalid_request": "invalid input for action {action}: {detail}",
    "unknown_property": "unknown property {name}",
    "missing_required_property": "missing required property {name}",
    "wrong_type_string": "property {name} must be a string",
    "wrong_type_integer": "property {name} must be an integer",
    "wrong_type_object": "property {name} must be an object",
    "wrong_type_array": "property {name} must be an array",
    "array_item_type": "property {name} must contain only strings",
    "invalid_enum": "property {name} must be one of {values}",
    "string_too_short": "property {name} must be at least {min} characters",
    "string_too_long": "property {name} must be at most {max} characters",
    "string_pattern": "property {name} contains characters that are not allowed",
    "integer_too_small": "property {name} must be at least {min}",
    "integer_too_large": "property {name} must be at most {max}",
    "invalid_observed_at": "property {name} must be an RFC3339 timestamp",
    "invalid_timeout": "invalid timeout: {value}",
    "refused_io": "the supervisor could not be reached",
    "workflow_invalid_action": "not a known action (status, inspect, events, wait, ready, controller_status, gate, complete, cancel)"
  },
  "applicability": {
    "status": {
      "access": "read",
      "permitted": ["action", "workflow_id", "supervisor_id"],
      "required": ["action", "workflow_id"],
      "types": {"action": "string", "workflow_id": "string", "supervisor_id": "string"}
    },
    "inspect": {
      "access": "read",
      "permitted": ["action", "workflow_id", "supervisor_id"],
      "required": ["action", "workflow_id"],
      "types": {"action": "string", "workflow_id": "string", "supervisor_id": "string"}
    },
    "events": {
      "access": "read",
      "permitted": ["action", "workflow_id", "after_seq", "limit", "supervisor_id"],
      "required": ["action", "workflow_id"],
      "types": {"action": "string", "workflow_id": "string", "after_seq": "integer", "limit": "integer", "supervisor_id": "string"}
    },
    "wait": {
      "access": "read",
      "permitted": ["action", "workflow_id", "timeout", "supervisor_id"],
      "required": ["action", "workflow_id"],
      "types": {"action": "string", "workflow_id": "string", "timeout": "string", "supervisor_id": "string"}
    },
    "ready": {
      "access": "read",
      "permitted": ["action", "controller_id", "limit", "supervisor_id"],
      "required": ["action", "controller_id"],
      "types": {"action": "string", "controller_id": "string", "limit": "integer", "supervisor_id": "string"}
    },
    "controller_status": {
      "access": "read",
      "permitted": ["action", "controller_id", "supervisor_id"],
      "required": ["action"],
      "types": {"action": "string", "controller_id": "string", "supervisor_id": "string"}
    },
    "gate": {
      "access": "owner",
      "permitted": ["action", "workflow_id", "node_id", "gate_id", "activation_id", "operation", "actor", "reason", "outcome", "subject", "poll_id", "source", "result", "response_hash", "observed_at", "evidence_ids", "supervisor_id"],
      "required": ["action", "workflow_id", "node_id", "gate_id", "activation_id", "operation"],
      "types": {"action": "string", "workflow_id": "string", "node_id": "string", "gate_id": "string", "activation_id": "string", "operation": "string", "actor": "string", "reason": "string", "outcome": "string", "subject": "json", "poll_id": "string", "source": "string", "result": "string", "response_hash": "string", "observed_at": "string", "evidence_ids": "array", "supervisor_id": "string"}
    },
    "complete": {
      "access": "owner",
      "permitted": ["action", "workflow_id", "node_id", "activation_id", "attempt_id", "lease_id", "owner_token", "outcome", "outputs", "artifacts", "supervisor_id"],
      "required": ["action", "workflow_id", "node_id", "activation_id", "attempt_id", "lease_id", "owner_token", "outcome"],
      "types": {"action": "string", "workflow_id": "string", "node_id": "string", "activation_id": "string", "attempt_id": "string", "lease_id": "string", "owner_token": "string", "outcome": "string", "outputs": "json", "artifacts": "json", "supervisor_id": "string"}
    },
    "cancel": {
      "access": "owner",
      "permitted": ["action", "workflow_id", "reason", "actor", "supervisor_id"],
      "required": ["action", "workflow_id", "reason", "actor"],
      "types": {"action": "string", "workflow_id": "string", "reason": "string", "actor": "string", "supervisor_id": "string"}
    }
  },
  "cases": [
    {
      "name": "status reads one workflow",
      "input": {"action": "status", "workflow_id": "wf-1"},
      "expect": {"action": "status", "call": "status", "args": {"workflow_id": "wf-1"}}
    },
    {
      "name": "inspect reads one workflow",
      "input": {"action": "inspect", "workflow_id": "wf-1"},
      "expect": {"action": "inspect", "call": "inspect", "args": {"workflow_id": "wf-1"}}
    },
    {
      "name": "events pages from a sequence",
      "input": {"action": "events", "workflow_id": "wf-1", "after_seq": 7, "limit": 20},
      "expect": {"action": "events", "call": "events", "args": {"workflow_id": "wf-1", "after_seq": 7, "limit": 20}}
    },
    {
      "name": "events accepts an integer-valued exponential sequence",
      "input": {"action": "events", "workflow_id": "wf-1", "after_seq": 1e3},
      "expect": {"action": "events", "call": "events", "args": {"workflow_id": "wf-1", "after_seq": 1000, "limit": 0}}
    },
    {
      "name": "wait defaults to thirty seconds",
      "input": {"action": "wait", "workflow_id": "wf-1"},
      "expect": {"action": "wait", "call": "wait", "args": {"workflow_id": "wf-1", "timeout_ms": 30000}}
    },
    {
      "name": "wait accepts a minute suffix",
      "input": {"action": "wait", "workflow_id": "wf-1", "timeout": "5m"},
      "expect": {"action": "wait", "call": "wait", "args": {"workflow_id": "wf-1", "timeout_ms": 300000}}
    },
    {
      "name": "ready reports candidates for a controller",
      "input": {"action": "ready", "controller_id": "ctl-1", "limit": 3},
      "expect": {"action": "ready", "call": "ready", "args": {"controller_id": "ctl-1", "limit": 3}}
    },
    {
      "name": "controller_status lists every controller",
      "input": {"action": "controller_status"},
      "expect": {"action": "controller_status", "call": "controller_list", "args": {}}
    },
    {
      "name": "controller_status reads one controller",
      "input": {"action": "controller_status", "controller_id": "ctl-1"},
      "expect": {"action": "controller_status", "call": "controller_status", "args": {"controller_id": "ctl-1"}}
    },
    {
      "name": "gate records an external result",
      "input": {"action": "gate", "workflow_id": "wf-1", "node_id": "n1", "gate_id": "g1", "activation_id": "a1", "operation": "external_result", "subject": {"type": "pr", "pull_request": 12}, "evidence_ids": ["e1", "e2"], "observed_at": "2026-10-29T12:00:00Z"},
      "expect": {"action": "gate", "call": "gate", "args": {"workflow_id": "wf-1", "node_id": "n1", "gate_id": "g1", "activation_id": "a1", "operation": "external_result", "subject": {"type": "pr", "pull_request": 12}, "evidence_ids": ["e1", "e2"], "observed_at": "2026-10-29T12:00:00Z"}}
    },
    {
      "name": "complete carries outputs and artifacts",
      "input": {"action": "complete", "workflow_id": "wf-1", "node_id": "n1", "activation_id": "a1", "attempt_id": "at1", "lease_id": "l1", "owner_token": "t1", "outcome": "ok", "outputs": [{"definition_id": "o1", "value": 1}], "artifacts": [{"src_path": "a", "stored_path": "b"}]},
      "expect": {"action": "complete", "call": "complete", "args": {"workflow_id": "wf-1", "node_id": "n1", "activation_id": "a1", "attempt_id": "at1", "lease_id": "l1", "owner_token": "t1", "outcome": "ok", "outputs": [{"definition_id": "o1", "value": 1}], "artifacts": [{"src_path": "a", "stored_path": "b"}]}}
    },
    {
      "name": "wait accepts a unitless second count",
      "input": {"action": "wait", "workflow_id": "wf-1", "timeout": "45"},
      "expect": {"action": "wait", "call": "wait", "args": {"workflow_id": "wf-1", "timeout_ms": 45000}}
    },
    {
      "name": "wait accepts an hour suffix",
      "input": {"action": "wait", "workflow_id": "wf-1", "timeout": "1h"},
      "expect": {"action": "wait", "call": "wait", "args": {"workflow_id": "wf-1", "timeout_ms": 3600000}}
    },
    {
      "name": "wait refuses a zero timeout",
      "input": {"action": "wait", "workflow_id": "wf-1", "timeout": "0s"},
      "expect": {"code": "invalid_request", "message": "invalid input for action \"wait\": invalid timeout: \"0s\""}
    },
    {
      "name": "cancel refuses an empty reason",
      "input": {"action": "cancel", "workflow_id": "wf-1", "reason": "", "actor": "op"},
      "expect": {"code": "invalid_request", "message": "invalid input for action \"cancel\": property \"reason\" must be at least 1 characters"}
    },
    {
      "name": "a timeout beyond the duration range is refused",
      "input": {"action": "wait", "workflow_id": "wf-1", "timeout": "9999999999h"},
      "expect": {"code": "invalid_request", "message": "invalid input for action \"wait\": invalid timeout: \"9999999999h\""}
    },
    {
      "name": "wait accepts the largest representable timeout",
      "input": {"action": "wait", "workflow_id": "wf-1", "timeout": "9223372036s"},
      "expect": {"action": "wait", "call": "wait", "args": {"workflow_id": "wf-1", "timeout_ms": 9223372036000}}
    },
    {
      "name": "status names a supervisor without forwarding it to the client",
      "input": {"action": "status", "workflow_id": "wf-1", "supervisor_id": "/tmp/sup-a.sock"},
      "expect": {"action": "status", "call": "status", "args": {"workflow_id": "wf-1"}}
    },
    {
      "name": "a non-string supervisor_id is refused",
      "input": {"action": "status", "workflow_id": "wf-1", "supervisor_id": 7},
      "schema": true,
      "expect": {"code": "invalid_request", "message": "invalid input for action \"status\": property \"supervisor_id\" must be a string"}
    },
    {
      "name": "an integer below the int64 range is refused",
      "input": {"action": "events", "workflow_id": "wf-1", "after_seq": -99999999999999999999},
      "schema": true,
      "expect": {"code": "invalid_request", "message": "invalid input for action \"events\": property \"after_seq\" must be at least -9223372036854775808"}
    },
    {
      "name": "an integer beyond the int64 range is refused",
      "input": {"action": "events", "workflow_id": "wf-1", "after_seq": 99999999999999999999},
      "schema": true,
      "expect": {"code": "invalid_request", "message": "invalid input for action \"events\": property \"after_seq\" must be at most 9223372036854775807"}
    },
    {
      "name": "cancel records the actor and reason",
      "input": {"action": "cancel", "workflow_id": "wf-1", "actor": "operator", "reason": "superseded"},
      "expect": {"action": "cancel", "call": "cancel", "args": {"workflow_id": "wf-1", "actor": "operator", "reason": "superseded"}}
    },
    {
      "name": "an unknown action is refused",
      "input": {"action": "explode"},
      "expect": {"code": "invalid_action", "message": "not a known action (status, inspect, events, wait, ready, controller_status, gate, complete, cancel)"}
    },
    {
      "name": "a property outside the action is refused",
      "input": {"action": "status", "workflow_id": "wf-1", "reason": "why"},
      "schema": true,
      "expect": {"code": "invalid_request", "message": "invalid input for action \"status\": unknown property \"reason\""}
    },
    {
      "name": "a missing required property is refused",
      "input": {"action": "status"},
      "schema": true,
      "expect": {"code": "invalid_request", "message": "invalid input for action \"status\": missing required property \"workflow_id\""}
    },
    {
      "name": "a string property refuses an integer",
      "input": {"action": "status", "workflow_id": 7},
      "schema": true,
      "expect": {"code": "invalid_request", "message": "invalid input for action \"status\": property \"workflow_id\" must be a string"}
    },
    {
      "name": "an integer property refuses a string",
      "input": {"action": "events", "workflow_id": "wf-1", "after_seq": "7"},
      "schema": true,
      "expect": {"code": "invalid_request", "message": "invalid input for action \"events\": property \"after_seq\" must be an integer"}
    },
    {
      "name": "an array property refuses a string",
      "input": {"action": "gate", "workflow_id": "wf-1", "node_id": "n1", "gate_id": "g1", "activation_id": "a1", "operation": "satisfy", "evidence_ids": "e1"},
      "schema": true,
      "expect": {"code": "invalid_request", "message": "invalid input for action \"gate\": property \"evidence_ids\" must be an array"}
    },
    {
      "name": "an array property refuses a non-string item",
      "input": {"action": "gate", "workflow_id": "wf-1", "node_id": "n1", "gate_id": "g1", "activation_id": "a1", "operation": "satisfy", "evidence_ids": ["e1", 2]},
      "schema": true,
      "expect": {"code": "invalid_request", "message": "invalid input for action \"gate\": property \"evidence_ids\" must contain only strings"}
    },
    {
      "name": "an unknown gate operation is refused",
      "input": {"action": "gate", "workflow_id": "wf-1", "node_id": "n1", "gate_id": "g1", "activation_id": "a1", "operation": "explode"},
      "schema": true,
      "expect": {"code": "invalid_request", "message": "invalid input for action \"gate\": property \"operation\" must be one of \"satisfy\", \"reject\", \"waive\", \"external_result\""}
    },
    {
      "name": "a non-RFC3339 observed_at is refused",
      "input": {"action": "gate", "workflow_id": "wf-1", "node_id": "n1", "gate_id": "g1", "activation_id": "a1", "operation": "external_result", "observed_at": "yesterday"},
      "expect": {"code": "invalid_request", "message": "invalid input for action \"gate\": property \"observed_at\" must be an RFC3339 timestamp"}
    },
    {
      "name": "an invalid timeout is refused",
      "input": {"action": "wait", "workflow_id": "wf-1", "timeout": "soon"},
      "expect": {"code": "invalid_request", "message": "invalid input for action \"wait\": invalid timeout: \"soon\""}
    },
    {
      "name": "cancel requires an actor",
      "input": {"action": "cancel", "workflow_id": "wf-1", "reason": "superseded"},
      "schema": true,
      "expect": {"code": "invalid_request", "message": "invalid input for action \"cancel\": missing required property \"actor\""}
    }
  ]
}
