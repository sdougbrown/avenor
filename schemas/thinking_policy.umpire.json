{
  "version": 1,
  "conditions": {
    "backend": {
      "type": "string",
      "description": "Backend identifier (e.g. codex-app-server, pi, claude)."
    },
    "resume": {
      "type": "boolean",
      "description": "Whether the value is being applied on an explicit resume rather than a fresh start."
    }
  },
  "fields": {
    "thinking": {
      "isEmpty": "string",
      "description": "Canonical thinking level, or empty to use the backend default."
    }
  },
  "rules": [
    {
      "type": "check",
      "field": "thinking",
      "check": {
        "op": "in",
        "field": "thinking",
        "value": ["off", "minimal", "low", "medium", "high", "xhigh", "max"]
      },
      "reason": "not a canonical thinking value (off, minimal, low, medium, high, xhigh, max)"
    },
    {
      "type": "eitherOf",
      "group": "thinkingPolicy",
      "field": "thinking",
      "branches": {
        "empty": [
          {
            "type": "fairWhen",
            "field": "thinking",
            "when": {
              "op": "absent",
              "field": "thinking"
            },
            "reason": "thinking is empty (backend default)"
          }
        ],
        "codexSupport": [
          {
            "type": "fairWhen",
            "field": "thinking",
            "when": {
              "op": "and",
              "exprs": [
                { "op": "condIn", "condition": "backend", "values": ["codex-app-server"] },
                { "op": "in", "field": "thinking", "values": ["low", "medium", "high", "xhigh", "max"] }
              ]
            },
            "reason": "codex-app-server supports low through max on start and resume; off and minimal are rejected by the API"
          }
        ],
        "piSupport": [
          {
            "type": "fairWhen",
            "field": "thinking",
            "when": {
              "op": "and",
              "exprs": [
                { "op": "condIn", "condition": "backend", "values": ["pi"] },
                { "op": "in", "field": "thinking", "values": ["off", "low", "medium", "high", "xhigh", "max"] }
              ]
            },
            "reason": "pi supports off and low through max on start and resume; it has no minimal level"
          }
        ],
        "claudeStart": [
          {
            "type": "fairWhen",
            "field": "thinking",
            "when": {
              "op": "and",
              "exprs": [
                { "op": "condIn", "condition": "backend", "values": ["claude", "claude-channel"] },
                { "op": "condEq", "condition": "resume", "value": false },
                { "op": "in", "field": "thinking", "values": ["low", "medium", "high", "xhigh", "max"] }
              ]
            },
            "reason": "claude and claude-channel support low through max only on a new session"
          }
        ]
      }
    }
  ]
}