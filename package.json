{
  "name": "avenor",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "scripts": {
    "board:dev": "bun run --cwd packages/board dev",
    "build": "bun run --cwd packages/core build && bun run --filter './packages/*' build",
    "test": "bun run --filter './packages/*' test",
    "test:e2e": "bun run --filter '@dougbots/avenor-core' test:e2e"
  }
}
